{
  "expo": {
    "name": "Нұр",
    "slug": "nur-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nur",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0D1640",
    "ios": {
      "bundleIdentifier": "kz.nurapp.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "kz.nurapp.app",
      "adaptiveIcon": {
        "backgroundColor": "#0D1640",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0D1640"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Намаз уақыттары мен Құбыла бағытын анықтау үшін орныңыз қажет. / Местоположение нужно для расчёта времени намаза и направления Киблы."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1D2A63"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
